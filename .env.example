# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Used for OpenRouter AI chat completions for the Trekking Assistant.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# MapTiler key used for frontend map tiles (restrict by referrer in MapTiler dashboard).
VITE_MAP_API_KEY="YOUR_MAPTILER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase — create a free project at https://supabase.com
# Find these under: Project Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
